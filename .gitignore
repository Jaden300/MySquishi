# --- Data & artifacts ---
*.db
*.sqlite
*.sqlite3
# New probe runs stay local by default. The four Phase 2 traces already in
# backend/calibration/ are tracked deliberately: ReplaySource is the demo
# insurance for when hardware fails, and insurance that only exists on the
# machine that recorded it is not insurance.
calibration/*.csv
models/*.joblib
models/*.pkl
backend/data/*.db

# The trained models and the synthetic cohort are tracked on purpose. A
# deployed instance has no way to train them and no persistent disk to keep
# them on, so the artifacts ship with the repo and the build stays a plain
# install. The database is not tracked: main.py seeds it on startup, and on a
# host with an ephemeral filesystem it is rebuilt on every boot anyway.
!backend/data/models/
!backend/data/cohort/

# --- Env & secrets ---
.env
.env.*
!.env.example

